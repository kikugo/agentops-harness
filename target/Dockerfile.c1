# C1 agent built from the pinned submodule (build context: vendor/droit-du-travail-copilot),
# plus this repo's tracing entrypoint (additional context "harness").
# data/articles.jsonl is mounted at run time; it's gitignored in C1.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /bin/uv

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY --from=harness target/c1-otel-requirements.txt /tmp/
RUN uv pip install --python /opt/venv/bin/python -r /tmp/c1-otel-requirements.txt
COPY copilot ./copilot
COPY retrieval ./retrieval
COPY ingest ./ingest
COPY --from=harness target/__init__.py target/tracing.py target/c1_otel.py ./target/

ENV PATH="/opt/venv/bin:$PATH"
EXPOSE 8000
CMD ["python", "-m", "target.c1_otel"]
