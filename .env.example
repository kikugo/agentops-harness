# Copy to .env. Names only; never commit values.

# C1 endpoints (same values as C1's `make env`)
AZURE_SEARCH_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
FOUNDRY_PROJECT_ENDPOINT=
CHAT_DEPLOYMENT=gpt-5.4-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Service principal for the C1 containers (read-only roles)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Folder holding C1's articles.jsonl and embeddings/ (read-only)
C1_DATA_DIR=../droit-du-travail-copilot/data

# Adapter key; garak reads it as OPENAICOMPATIBLE_API_KEY, PyRIT as OPENAI_CHAT_KEY
ADAPTER_API_KEY=
# set to http://c1-redteam:8000 when running with --profile redteam
C1_REDTEAM_URL=

# Local Langfuse: scripts/langfuse_env.sh appends its secrets, project keys and
# OTEL_EXPORTER_OTLP_TRACES_HEADERS here. Leave OTEL_EXPORTER_OTLP_TRACES_ENDPOINT empty
# to keep the default (the langfuse-web service); set it to "" in the shell to turn tracing off.

# Attacker and judge models (later phases)
GROQ_API_KEY=
OPENROUTER_API_KEY=
